# ---------- OpenRouter (required for AI viral analysis) ----------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=120
OPENROUTER_MAX_RETRIES=3
OPENROUTER_BATCH_SIZE=8

# ---------- Whisper ----------
WHISPER_MODEL=medium
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_VAD=1

# ---------- Clip defaults ----------
MAX_CLIPS=5
MIN_CLIP_DURATION=20
MAX_CLIP_DURATION=60
DEFAULT_ASPECT_RATIO=9:16
DEFAULT_CAPTION_STYLE=hormozi_green

# ---------- Paths ----------
OUTPUT_DIR=workspace/clips
# VIRALCUT_WORKSPACE=workspace

# ---------- YouTube auth (optional, for private/age-restricted videos) ----------
# VIRALCUT_COOKIES_FILE=/path/to/cookies.txt

# ---------- Server ----------
HOST=0.0.0.0
PORT=8000

# ---------- Versioning ----------
PROMPT_VERSION=1.0
SCORING_VERSION=1.0